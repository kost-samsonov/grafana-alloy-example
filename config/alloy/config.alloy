// ==================== ПРИЁМ ДАННЫХ ОТ КЛИЕНТА ====================
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// ==================== ЛОКАЛЬНЫЕ РЕСИВЕРЫ (ДЛЯ УНИФИКАЦИИ) ====================
otelcol.receiver.prometheus "default" {
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.receiver.loki "default" {
  output {
    logs = [otelcol.processor.batch.default.input]
  }
}

// ==================== БАТЧИРОВАНИЕ ====================
otelcol.processor.batch "default" {
  timeout          = "5s"
  send_batch_size  = 1024
  output {
    metrics = [otelcol.exporter.prometheus.mimir.input]
    logs    = [otelcol.exporter.loki.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// ==================== ЭКСПОРТЁРЫ В ХРАНИЛИЩА ====================
otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

otelcol.exporter.loki "loki" {
  forward_to = [loki.write.loki.receiver]
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

pyroscope.write "pyroscope" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}

// ==================== СБОР ЛОГОВ ХОСТА ====================
local.file_match "host_logs" {
  path_targets = [
    {
    __path__ = "/var/log/*.log",
     job = "host_varlogs",
    },
  ]
}

loki.process "host_logs" {
  forward_to = [otelcol.receiver.loki.default.receiver]
  stage.static_labels {
    values = {
      host = sys.env("HOSTNAME_FROM_HOST"),
      job  = "host_varlogs",
    }
  }
}

loki.source.file "host_logs" {
  targets    = local.file_match.host_logs.targets
  forward_to = [loki.process.host_logs.receiver]
}

// ==================== СБОР ЛОГОВ КОНТЕЙНЕРОВ ====================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_port_public_ip"]
    regex         = "::"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "container_image"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "container_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "container_project"
  }
}

loki.process "container_logs" {
  forward_to = [otelcol.receiver.loki.default.receiver]
  stage.static_labels {
    values = {
      host = sys.env("HOSTNAME_FROM_HOST"),
      job  = "docker_logs",
    }
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.container_logs.receiver]
}

// ==================== СБОР МЕТРИК ====================
// Node Exporter

// Обнаруживаем все контейнеры на Docker-хосте
discovery.docker "node_exporter" {
  host = "unix:///var/run/docker.sock"
}

// Фильтруем и перезаписываем лейблы
discovery.relabel "node_exporter" {
  targets = discovery.docker.node_exporter.targets

  // Оставляем только контейнер с именем node_exporter
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/node_exporter"
    action        = "keep"
  }

  // Устанавливаем адрес: используем имя контейнера и порт (если порт проброшен)
  rule {
    source_labels = ["__meta_docker_container_name", "__meta_docker_container_port"]
    separator     = ":"
    target_label  = "__address__"
    regex         = "/(.+):(.*)"
    replacement   = "$1:$2"
  }

  // Устанавливаем instance = короткий ID контейнера
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "instance"
    regex         = "([a-f0-9]{12})"
    replacement   = "$1"
  }

  // Добавляем job и host, если нужно
  rule {
    target_label = "job"
    replacement  = "host_node_exporter"
  }
  rule {
    target_label = "host"
    replacement  = sys.env("HOSTNAME_FROM_HOST")
  }
}


prometheus.scrape "node_exporter" {
  targets    = discovery.relabel.node_exporter.output
  forward_to = [otelcol.receiver.prometheus.default.receiver]
}

// cAdvisor
prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
  docker_only = true
  store_container_labels = true
}

prometheus.scrape "cadvisor" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  forward_to      = [prometheus.relabel.cadvisor_metrics.receiver]
  scrape_interval = "15s"
}

prometheus.relabel "cadvisor_metrics" {
  forward_to = [otelcol.receiver.prometheus.default.receiver]

  rule {
    target_label = "host"
    replacement  = sys.env("HOSTNAME_FROM_HOST")
  }

  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    target_label  = "container_service"
  }

  rule {
    source_labels = ["container_label_com_docker_compose_project"]
    target_label  = "container_project"
  }

  rule {
    target_label = "job"
    replacement  = "docker_cadvisor"
  }
}

// Self metrics (метрики самого Alloy)
prometheus.exporter.self "alloy" {}
prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [otelcol.receiver.prometheus.default.receiver]
}

// ==================== ВНУТРЕННИЕ ЛОГИ И ТРЕЙСЫ ALLOY ====================
logging {
  level = "debug"
  write_to = [loki.relabel.alloy_logs.receiver]
}

loki.relabel "alloy_logs" {
  rule {
    target_label = "host"
    replacement  = sys.env("HOSTNAME_FROM_HOST")
  }
  rule {
    target_label = "job"
    replacement  = "integrations/self"
  }
  forward_to = [loki.write.loki.receiver]  // отправляем напрямую в Loki, минуя batch (как в клиенте нет аналога)
}

tracing {
  sampling_fraction = 1.0
  write_to = [otelcol.exporter.otlp.tempo.input]  // напрямую в Tempo
}

// ==================== ПРОФИЛИРОВАНИЕ ====================
pyroscope.scrape "default" {
  targets = [{
    __address__   = "localhost:12345",
    service_name  = "alloy",
  }]
  forward_to = [pyroscope.write.pyroscope.receiver]
}
