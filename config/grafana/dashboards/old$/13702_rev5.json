      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "exemplar": true,
          "expr": "node_uname_info{host=~\"$host\"}",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "(1 - avg(rate(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"}[$__rate_interval])) by (host)) * 100",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "",
          "refId": "C"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - (node_memory_MemAvailable_bytes{host=~\"$host\"} / (node_memory_MemTotal_bytes{host=~\"$host\"}))) * 100",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "D"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max((1 - (node_filesystem_free_bytes{host=~\"$host\"} / node_filesystem_size_bytes{host=~\"$host\"})) * 100) by (host)",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "F"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max(rate(node_disk_read_bytes_total{host=~\"$host\"}[$__rate_interval])) by (host)",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "",
          "refId": "G"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max(rate(node_disk_written_bytes_total{host=~\"$host\"}[$__rate_interval])) by (host)",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "",
          "refId": "H"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_netstat_Tcp_CurrEstab{host=~\"$host\"} - 0",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "I"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_sockstat_TCP_tw{host=~\"$host\"} - 0",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "J"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max(rate(node_network_receive_bytes_total{host=~\"$host\"}[$__rate_interval])*8) by (host)",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "",
          "refId": "K"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max(rate(node_network_transmit_bytes_total{host=~\"$host\"}[$__rate_interval])*8) by (host)",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "",
          "refId": "L"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "avg(node_load1{host=~\"$host\"} * 100) by (host) / count (node_cpu_seconds_total{host=~\"$host\", mode=\"system\"}) by (host)",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "M"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_sockstat_sockets_used{host=~\"$host\"}",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "N"
        }
      ],
